{
  "name": "programflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "WRANGLER_WRITE_LOGS=false tsc -b && WRANGLER_WRITE_LOGS=false vite build",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --config wrangler.jsonc --env evaluation && WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --config wrangler.jsonc --env production",
    "cf:typegen": "wrangler types",
    "db:generate": "drizzle-kit generate --config packages/database/drizzle.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev": "WRANGLER_WRITE_LOGS=false vite",
    "lint": "eslint .",
    "reset:evaluation": "tsx scripts/reset-evaluation.ts",
    "seed:evaluation": "tsx scripts/seed-evaluation.ts",
    "sync:evaluator-auth": "tsx scripts/sync-evaluator-auth.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.101.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
