{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "programflow",
  "main": "./apps/worker/src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "local",
    "SOURCE_URL": "https://github.com/VasuBansal7576/kill-my-saas"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "programflow-jobs-local", "remote": false }
    ],
    "consumers": [
      { "queue": "programflow-jobs-local", "max_batch_size": 10, "max_batch_timeout": 5 }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "env": {
    "evaluation": {
      "name": "programflow-evaluation",
      "vars": {
        "APP_ENV": "evaluation",
        "SOURCE_URL": "https://github.com/VasuBansal7576/kill-my-saas",
        "EVALUATION_RESET_RUNBOOK_URL": "https://github.com/VasuBansal7576/kill-my-saas/blob/main/docs/runbooks/evaluation.md#controlled-evaluation-reset",
        "FILES_BUCKET": "programflow-files",
        "FILES_ENDPOINT_URL": "https://br-delicate-hall-aywwqjp5.storage.c-5.us-east-2.aws.neon.tech",
        "FILES_REGION": "us-east-2",
        "NEON_AUTH_BASE_URL": "https://ep-hidden-night-axu8hcwx.neonauth.c-4.us-east-2.aws.neon.tech/neondb/auth"
      },
      "ai": { "binding": "AI", "remote": true },
      "queues": {
        "producers": [
          { "binding": "JOBS", "queue": "programflow-jobs-evaluation" }
        ],
        "consumers": [
          { "queue": "programflow-jobs-evaluation", "max_batch_size": 10, "max_batch_timeout": 5 }
        ]
      },
      "triggers": { "crons": ["*/5 * * * *"] }
    },
    "production": {
      "name": "programflow-production",
      "vars": {
        "APP_ENV": "production",
        "SOURCE_URL": "https://github.com/VasuBansal7576/kill-my-saas",
        "FILES_BUCKET": "programflow-files",
        "FILES_ENDPOINT_URL": "https://br-damp-leaf-ay3y6zv0.storage.c-5.us-east-2.aws.neon.tech",
        "FILES_REGION": "us-east-2",
        "NEON_AUTH_BASE_URL": "https://ep-broad-dust-ayiylwto.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth"
      },
      "ai": { "binding": "AI", "remote": true },
      "queues": {
        "producers": [
          { "binding": "JOBS", "queue": "programflow-jobs-production" }
        ],
        "consumers": [
          { "queue": "programflow-jobs-production", "max_batch_size": 10, "max_batch_timeout": 5 }
        ]
      },
      "triggers": { "crons": ["*/5 * * * *"] }
    }
  }
}
