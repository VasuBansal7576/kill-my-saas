{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "programflow",
  "main": "./apps/worker/src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "local" },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "programflow-files-local", "remote": false }
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "programflow-jobs-local", "remote": false }
    ],
    "consumers": [
      { "queue": "programflow-jobs-local", "max_batch_size": 10, "max_batch_timeout": 5 }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "env": {
    "evaluation": {
      "name": "programflow-evaluation",
      "vars": { "APP_ENV": "evaluation" },
      "ai": { "binding": "AI", "remote": true }
    },
    "production": {
      "name": "programflow-production",
      "vars": { "APP_ENV": "production" },
      "ai": { "binding": "AI", "remote": true }
    }
  }
}
