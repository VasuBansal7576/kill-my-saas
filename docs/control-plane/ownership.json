{
  "schema_version": 2,
  "purpose": "Define exclusive change ownership and machine-checkable handoff content for isolated worktree PRs.",
  "authority": "architecture.md#7-deep-modules-and-ownership",
  "branch_policy": {
    "prefix": "agent/",
    "one_writer_per_worktree": true,
    "one_primary_module_owner_per_pr": true,
    "draft_pr_required": true,
    "base_branch": "main",
    "feature_claims_require_ledger_ids": true
  },
  "coordination_rules": [
    "Declare exact owned paths and requirement IDs before implementation.",
    "Do not edit another active PR's owned paths; request a structured handoff or sequence the work.",
    "Changes to shared hotspots require an explicit shared-owner handoff in the PR description.",
    "Do not mark an ID verified until persistence, authorization, downstream handoff and evidence all pass.",
    "Update rubric_item_tracking for every claimed rubric ID; area rollups are derived and may not be edited as a substitute.",
    "Production behavior may not select mock, demo or in-memory adapters.",
    "V2 work is blocked while any V1 contract or release proof is incomplete unless the user reprioritizes."
  ],
  "shared_hotspots": [
    {"name": "database-schema-and-migrations", "future_paths": ["packages/database/**"], "required_reviewers": ["identity-access", "owning-domain-module"]},
    {"name": "identity-and-authorization", "future_paths": ["apps/worker/src/modules/identity-access/**", "apps/worker/src/http/middleware/**"], "required_reviewers": ["identity-access"]},
    {"name": "cross-tier-contracts", "future_paths": ["packages/contracts/**"], "required_reviewers": ["owning-domain-module", "web-consumer"]},
    {"name": "outbox-jobs-and-evidence", "future_paths": ["apps/worker/src/jobs/**", "apps/worker/src/modules/operations-evidence/**"], "required_reviewers": ["operations-evidence", "emitting-domain-module"]},
    {"name": "application-shell-and-locked-tokens", "future_paths": ["apps/web/src/app/**", "apps/web/src/styles/**", "packages/ui/**"], "required_reviewers": ["web-shell"]},
    {"name": "control-plane", "paths": ["docs/requirements/**", "docs/control-plane/**", "docs/fixtures/**", "scripts/validate-control-plane.mjs", "architecture.md", "AGENTS.md"], "required_reviewers": ["program-control"]}
  ],
  "modules": [
    {"id": "identity-access", "name": "Identity & Access", "future_path": "apps/worker/src/modules/identity-access", "owns": ["identities", "email aliases", "sessions", "organization memberships", "event memberships", "role grants"], "downstream": ["all protected modules", "evaluator personas"]},
    {"id": "event-configuration", "name": "Event Configuration", "future_path": "apps/worker/src/modules/event-configuration", "owns": ["organizations", "events", "tracks", "formats", "rooms", "branding"], "downstream": ["forms-submissions", "scheduling", "publishing"]},
    {"id": "forms-submissions", "name": "Forms & Submissions", "future_path": "apps/worker/src/modules/forms-submissions", "owns": ["CFP forms and versions", "fields", "conditions", "routing rules", "submissions and versions", "participants", "answers"], "downstream": ["reviews-decisions"]},
    {"id": "reviews-decisions", "name": "Reviews & Decisions", "future_path": "apps/worker/src/modules/reviews-decisions", "owns": ["plans", "rounds", "scorecards", "reviewer pools", "assignments", "responses", "recusals", "AI assessments", "decisions"], "downstream": ["program", "communications"]},
    {"id": "program", "name": "Program", "future_path": "apps/worker/src/modules/program", "owns": ["sessions", "session speakers", "session content versions", "approval state"], "downstream": ["speaker-operations", "scheduling", "publishing", "integrations"]},
    {"id": "speaker-operations", "name": "Speaker Operations", "future_path": "apps/worker/src/modules/speaker-operations", "owns": ["speaker profiles and versions", "event speakers", "custom fields", "tasks", "task forms", "task assignments", "resources"], "downstream": ["files-deliverables", "publishing", "communications"]},
    {"id": "files-deliverables", "name": "Files & Deliverables", "future_path": "apps/worker/src/modules/files-deliverables", "owns": ["file assets", "deliverables", "file versions", "comments", "ZIP and export manifests"], "downstream": ["speaker-operations", "program", "operations-evidence"]},
    {"id": "scheduling", "name": "Scheduling", "future_path": "apps/worker/src/modules/scheduling", "owns": ["placements", "schedule revisions", "computed conflicts", "publication readiness"], "downstream": ["publishing", "communications", "integrations"]},
    {"id": "communications", "name": "Communications", "future_path": "apps/worker/src/modules/communications", "owns": ["templates", "campaigns", "recipients", "deliveries", "calendar artifacts"], "downstream": ["email provider", "operations-evidence"]},
    {"id": "publishing", "name": "Publishing", "future_path": "apps/worker/src/modules/publishing", "owns": ["publication state and settings", "widget configurations", "attendee itineraries and items"], "downstream": ["public web", "embed and data consumers"]},
    {"id": "integrations", "name": "Integrations", "future_path": "apps/worker/src/modules/integrations", "owns": ["encrypted integration configs", "mappings", "external links", "integration runs and items"], "downstream": ["Accelevents", "Airtable", "operations-evidence"]},
    {"id": "speaker-crm", "name": "Speaker CRM", "future_path": "apps/worker/src/modules/speaker-crm", "owns": ["CRM contact extensions", "notes", "tags", "custom fields", "duplicate candidates", "merges", "segments", "pipelines and transitions"], "downstream": ["speaker-operations", "communications"]},
    {"id": "operations-evidence", "name": "Operations & Evidence", "future_path": "apps/worker/src/modules/operations-evidence", "owns": ["outbox", "job attempts", "activity feed", "evidence records", "dashboard projections"], "downstream": ["release evidence bundle"]}
  ],
  "structured_handoff": {
    "format": "JSON object in PR description or docs/control-plane/handoffs/<branch>.json",
    "required_fields": [
      "branch",
      "commit_sha",
      "primary_module",
      "owned_paths",
      "requirement_ids",
      "requirement_status_updates",
      "scenario_ids",
      "roles",
      "persisted_state_before",
      "persisted_state_after",
      "downstream_handoffs",
      "idempotency_and_failure_behavior",
      "automated_evidence",
      "manual_evidence",
      "routes_or_visual_workspaces",
      "migrations",
      "observability",
      "accessibility",
      "performance",
      "known_blockers"
    ],
    "completion_rule": "All required fields must be present; empty values must be explicit nulls with a reason."
  }
}
